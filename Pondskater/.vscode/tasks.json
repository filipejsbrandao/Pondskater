{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-plugin-netcore",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/Pondskater.csproj",
                "--configuration",
                "Debug",
                "--framework",
                "net7.0",
                "--no-restore"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
